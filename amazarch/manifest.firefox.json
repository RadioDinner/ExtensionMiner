{
  "manifest_version": 3,
  "name": "Amazarch",
  "version": "0.0.5",
  "description": "Match your Amazon orders, refunds, and split shipments to your Monarch Money transactions. Not affiliated with Amazon or Monarch Money.",
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amazarch"
  },
  "content_scripts": [
    {
      "matches": ["https://app.monarchmoney.com/*", "https://app.monarch.com/*"],
      "js": ["monarch-content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://app.monarchmoney.com/*",
    "https://app.monarch.com/*",
    "https://api.monarchmoney.com/*",
    "https://api.monarch.com/*",
    "https://www.amazon.com/*"
  ],
  "permissions": ["storage", "alarms"],
  "browser_specific_settings": {
    "gecko": {
      "id": "amazarch@radiodinner.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "financialAndPaymentInfo"]
      }
    }
  }
}
