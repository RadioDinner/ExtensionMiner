# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# --- Supabase (server-side) -------------------------------------------------
# Use the SERVICE ROLE key, not the anon key: the schema enables RLS with no
# policies, so only the service role can read/write. Keep it secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude API (ranking layer) -----------------------------------
ANTHROPIC_API_KEY=

# --- Scraper politeness -----------------------------------------------------
SCRAPER_RATE_LIMIT_SECONDS=3
SCRAPER_CACHE_DIR=data/cache
SCRAPER_USER_AGENT=ExtensionMiner/0.1 (research; contact: you@example.com)

# --- Targeting (start small — 1–3 categories) -------------------------------
# Comma-separated Chrome Web Store category slugs.
TARGET_CATEGORIES=productivity,developer-tools
